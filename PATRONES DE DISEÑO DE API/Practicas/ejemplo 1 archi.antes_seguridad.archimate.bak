<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="MedConnect Ecosistema - Agendamiento de citas" id="id-e83e4af4940043b58d934b1aa8d0f50b" version="5.0.0">
  <folder name="Strategy" id="id-224ec0b4be5b480298b319340d5403c1" type="strategy"/>
  <folder name="Business" id="id-192e9a5732b64d029ddc0bb4e1e3f3cf" type="business">
    <element xsi:type="archimate:BusinessActor" name="Doctor" id="id-5b63438ac425408fbb6b66cc278ce23c"/>
    <element xsi:type="archimate:BusinessProcess" name="Agendar y confirmar cita" id="id-da015f3761d64aa9a95392b9f4f68cb8">
      <documentation>Business Process: consultar disponibilidad vigente, validar paciente y reservar de forma consistente. Contribuye al Outcome; no implica garantía de rendimiento sin medición.</documentation>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Gestión de agenda clínica" id="id-22395a9f7e7c4bb09b60f8e4ca8ee68b"/>
    <element xsi:type="archimate:BusinessRole" name="Coordinación de citas" id="id-9758f3c04eb349b2b8be71f02712d7df"/>
    <element xsi:type="archimate:BusinessObject" name="Solicitud de cita" id="id-aa3559ea5649479d8b05b50de5a0bb89"/>
    <element xsi:type="archimate:BusinessService" name="Disponibilidad Horaria Doctor" id="id-d61a7cadb9854e5aa13b3e5348a8d6a8"/>
    <element xsi:type="archimate:BusinessActor" name="Enfermera" id="id-b48649c9ffe34695aafa905d863c6df6"/>
    <element xsi:type="archimate:BusinessActor" name="Pacientes" id="id-88ca1b2fbf6a44439cac2def67e02cc4"/>
    <element xsi:type="archimate:BusinessProcess" name="Revision citas pendientes" id="id-f63aacf382c4435eab38837e9754fd7b"/>
    <element xsi:type="archimate:BusinessProcess" name="Disponibilidad de consultorio" id="id-cde167b09bc945439a8cb2949f84c8d1"/>
    <element xsi:type="archimate:BusinessService" name="Agendamiento" id="id-99e07de9d7c74351b602cf50497cf2e0"/>
    <element xsi:type="archimate:BusinessActor" name="Centro médico aliado" id="id-5bde9f4ac4b04422a56ad0b9cd4017cf">
      <documentation>Aliado que opera el proceso de agendamiento y mide la conversión de solicitudes válidas en citas confirmadas.</documentation>
    </element>
  </folder>
  <folder name="Application" id="id-916d20c33aa14c82968eefcec614c47a" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Motor de agendamiento MedConnect" id="id-87f96994819b464a80e523b203a3ceb7">
      <documentation>Application Component interno que implementa disponibilidad, validación y confirmación de reservas. Separa el código del servicio expuesto y de su contrato REST/JSON.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="API Gateway" id="id-2e55fb090aff494fbc161f2dfa0858a5"/>
    <element xsi:type="archimate:ApplicationComponent" name="Portal del aliado" id="id-bb23e1ea56194614adbfed06220108e5"/>
    <element xsi:type="archimate:ApplicationComponent" name="SSO" id="id-05a523d37fa2466cac2604c7b0aeeac3"/>
    <element xsi:type="archimate:ApplicationComponent" name="Webhook notificaciones" id="id-f294acf661454cfe9a755e598d7ea01f"/>
    <element xsi:type="archimate:ApplicationService" name="Consultar disponibilidad y confirmar cita" id="id-401b4c5b35e744a088be5fe4c43dbfa6">
      <documentation>Application Service consumido por el proceso de negocio. La interfaz API_Riesgo_v1 lo expone. La confirmación requiere persistencia consistente; una respuesta parcial no equivale a una cita confirmada.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="API_Riesgo_v1 (REST/JSON)" id="id-c62dfd77da3d479095b42af09a2e6c5d">
      <documentation>Nombre exigido por el taller, aplicado aquí al contrato de agendamiento de MedConnect. Punto de acceso externo del componente; no representa un cálculo de riesgo clínico ni acceso directo a la base de datos. Operaciones conceptuales: GET /v1/disponibilidad y POST /v1/citas.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Agenda y citas" id="id-3635648e6610420b87ee9d180ec13ef8">
      <documentation>Información lógica de disponibilidad y reservas. Se materializa físicamente en el Artifact Base de datos de citas.</documentation>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-b79719a5e69c4dfa8324f5fc4bc0a743" type="technology">
    <element xsi:type="archimate:Node" name="Kubernetes Cloud" id="id-10ce34a194084d679a4e3abb85a82471">
      <documentation>Node de ejecución del componente de agendamiento conservado del modelo inicial; sin despliegue real verificado.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="SQL Azure" id="id-30f2924ca0c344759927cdb79639e6e3">
      <documentation>Node tecnológico de persistencia ya presente en el modelo original. Aloja el Artifact de citas y sirve al componente de agendamiento. Representa una decisión del modelo académico, no un despliegue verificado.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="AWS" id="id-061c55c23c4246cbb3af86396402e8cc"/>
    <element xsi:type="archimate:Artifact" name="Base de datos de citas" id="id-5ec165bfa4984bdf95f8ee1a0945f588">
      <documentation>Artifact: esquema y datos físicos de agenda y reservas, desplegados en el nodo SQL Azure. Realiza el Data Object Agenda y citas. No es un Application Component.</documentation>
    </element>
  </folder>
  <folder name="Motivation" id="id-25339b8dca0a4c65a8e667a12cc17b3c" type="motivation">
    <element xsi:type="archimate:Goal" name="Aumentar conversión a citas confirmadas" id="id-66301fca8b2a41c5a67324fd46430886">
      <documentation>Goal: habilitar una API interoperable de MedConnect que aumente la proporción de solicitudes válidas que terminan en una cita confirmada para el centro médico aliado. Sin línea base ni incremento porcentual medido.</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="Agendamiento confirmado en máximo 3 s" id="id-c7e17c23042941bda9669de2457953dc">
      <documentation>Outcome esperado, no resultado medido. Meta operativa propuesta: p95 del tiempo de confirmación extremo a extremo &lt;= 3 s, desde confirmar en el canal del aliado hasta recibir la reserva persistida. Medir errores y timeouts además de latencia para evitar sesgo de supervivencia.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Demanda de agendamiento digital ágil" id="id-be23c68e1ce84b778b0687a73fb74016">
      <documentation>Driver de MedConnect: transformación digital del acceso a citas y necesidad del aliado de reducir fricción y esperas.</documentation>
    </element>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-77710fefa25147c0ba0729af8dc664e1" type="implementation_migration"/>
